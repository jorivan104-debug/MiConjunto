# Mi Conjunto — environment variables

# Postgres for production:
# DATABASE_URL=postgresql://miconjunto:secret@localhost:5432/miconjunto
DATABASE_URL=sqlite:///./miconjunto.db

APP_ENV=development

# Long random string in production
SECRET_KEY=please-change-me-in-production-use-a-long-random-string

# Optional Fernet key for TOTP secret encryption. If empty, derived from SECRET_KEY.
TOTP_ENCRYPTION_KEY=

# Initial admin (only created if users table is empty)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin
BOOTSTRAP_ADMIN_EMAIL=admin@miconjunto.app

ALLOW_PUBLIC_REGISTRATION=false
